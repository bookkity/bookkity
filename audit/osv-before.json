    "GHSA-f3mh-rxg3-f5g2": {
      "id": "GHSA-f3mh-rxg3-f5g2",
      "summary": "Next.js: HttpOnly cookie exposure through internal response header on Next.js Edge runtime routes",
      "details": "Next.js applications that set cookies through `NextResponse` on Edge runtime routes \u2014 App Router route handlers and Pages Router Edge API routes \u2014 send an internal `x-middleware-set-cookie` header in the public response, duplicating the cookie value and its attributes. This makes HttpOnly cookies, such as session tokens, readable by JavaScript running on the same origin when an application sets a sensitive cookie on an affected response.",
      "aliases": [
        "CVE-2026-119346"
      ],
      "modified": "2026-11-19T22:45:06.180078081Z",
      "published": "2026-11-19T22:23:21Z",
