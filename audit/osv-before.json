  "advisories": {
    "GHSA-7qx7-33qx-rqx2": {
      "id": "GHSA-7qx7-33qx-rqx2",
      "summary": "Next.js: SVG rejection bypass in the image optimization",
      "details": "On self-hosted deployments, the Next.js image optimizer (`/_next/image`) can be made to process an attacker-supplied SVG even when SVG support is disabled with `dangerouslyAllowSVG: false` (the default). This reaches an SVG parser the application intended to keep disabled, increasing exposure to denial of service and SVG decoder vulnerabilities.",
      "aliases": [
        "CVE-2026-119347"
      ],
      "modified": "2026-11-19T22:45:06.164972711Z",
